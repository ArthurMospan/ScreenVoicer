<Application x:Class="ScreenVoicer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Segoe UI Variable on Windows 11, Segoe UI elsewhere -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ═══ Brand «Tally»: dark glass, one warm accent (the recording lamp) ═══ -->
        <Color x:Key="AccentColor">#FF8A4C</Color>
        <Color x:Key="AccentLightColor">#FFC68A</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8A4C"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFC68A"/>

        <SolidColorBrush x:Key="WindowBrush" Color="#0F0F13"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#17171D"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#1E1E25"/>
        <SolidColorBrush x:Key="InkBrush" Color="#F3F3F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAAAB6"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#6B6B78"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>

        <!-- Matte glass: flat frosted fills and one thin even edge — no sheen, no glints, no glow.
             Active = translucent white, primary = near-solid white with dark ink, the accent lives in icons. -->
        <SolidColorBrush x:Key="GlassSheen" Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="GlassRim" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="PanelRim" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="GlassText" Color="#F4F4F7"/>
        <SolidColorBrush x:Key="GlassPlaceholder" Color="#CFCFD6"/>
        <SolidColorBrush x:Key="PrimaryFill" Color="#EBFFFFFF"/>
        <SolidColorBrush x:Key="PrimaryInk" Color="#1D1D22"/>
        <SolidColorBrush x:Key="AccentFill" Color="#FF8A4C"/>
        <SolidColorBrush x:Key="AccentRim" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="RecordFill" Color="#FF4D5E"/>
        <SolidColorBrush x:Key="ActiveTint" Color="#38FFFFFF"/>
        <DropShadowEffect x:Key="AccentGlow" Color="#FF8A4C" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
        <DropShadowEffect x:Key="RecordGlow" Color="#FF4D5E" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
        <DropShadowEffect x:Key="LiftShadow" Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.3"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.45"/>

        <!-- ═══ Line icons: 24-unit grid, drawn by GlyphIcon with round caps (same geometry as the logo brackets) ═══ -->
        <Geometry x:Key="Icon.Region">M4 9V6.5A2.5 2.5 0 0 1 6.5 4H9M15 4H17.5A2.5 2.5 0 0 1 20 6.5V9M20 15V17.5A2.5 2.5 0 0 1 17.5 20H15M9 20H6.5A2.5 2.5 0 0 1 4 17.5V15</Geometry>
        <Geometry x:Key="Icon.Screen">M4.5 5H19.5A1.5 1.5 0 0 1 21 6.5V15.5A1.5 1.5 0 0 1 19.5 17H4.5A1.5 1.5 0 0 1 3 15.5V6.5A1.5 1.5 0 0 1 4.5 5ZM9 20.5H15M12 17V20.5</Geometry>
        <Geometry x:Key="Icon.Pen">M15 5.5L18.5 9L9 18.5L4.5 19.5L5.5 15ZM13 7.5L16.5 11</Geometry>
        <Geometry x:Key="Icon.Highlighter">M14.5 4.5L19.5 9.5L12.5 16.5L7.5 11.5ZM7.5 11.5L5.5 17L7 18.5L12.5 16.5M4 20.5H11</Geometry>
        <Geometry x:Key="Icon.Arrow">M5.5 18.5L18.5 5.5M10 5.5H18.5V14</Geometry>
        <Geometry x:Key="Icon.Rectangle">M6.5 5H17.5A2.5 2.5 0 0 1 20 7.5V16.5A2.5 2.5 0 0 1 17.5 19H6.5A2.5 2.5 0 0 1 4 16.5V7.5A2.5 2.5 0 0 1 6.5 5Z</Geometry>
        <Geometry x:Key="Icon.Text">M5 7.5V5H19V7.5M12 5V19M9 19H15</Geometry>
        <Geometry x:Key="Icon.Number">M12 3.5A8.5 8.5 0 1 1 11.99 3.5ZM10.5 9.5L12.5 8V16.5</Geometry>
        <Geometry x:Key="Icon.Blur">M6.5 4.5H17.5A2 2 0 0 1 19.5 6.5V17.5A2 2 0 0 1 17.5 19.5H6.5A2 2 0 0 1 4.5 17.5V6.5A2 2 0 0 1 6.5 4.5ZM4.5 9.5H19.5M4.5 14.5H19.5M9.5 4.5V19.5M14.5 4.5V19.5</Geometry>
        <Geometry x:Key="Icon.Eraser">M9 20H20M5.7 14.3L14.3 5.7A2 2 0 0 1 17.1 5.7L19.3 7.9A2 2 0 0 1 19.3 10.7L11 19H8.4ZM9.5 10.5L14.5 15.5</Geometry>
        <Geometry x:Key="Icon.Undo">M9 14L4.5 9.5L9 5M4.5 9.5H14A5.5 5.5 0 0 1 14 20.5H11</Geometry>
        <Geometry x:Key="Icon.Redo">M15 14L19.5 9.5L15 5M19.5 9.5H10A5.5 5.5 0 0 0 10 20.5H13</Geometry>
        <Geometry x:Key="Icon.Mic">M12 3.5A3 3 0 0 1 15 6.5V12A3 3 0 0 1 9 12V6.5A3 3 0 0 1 12 3.5ZM5.5 11.5A6.5 6.5 0 0 0 18.5 11.5M12 18V20.5</Geometry>
        <Geometry x:Key="Icon.Chevron">M6.5 9.5L12 15L17.5 9.5</Geometry>
        <Geometry x:Key="Icon.Check">M5 12.5L9.5 17L19 7.5</Geometry>
        <Geometry x:Key="Icon.Close">M6.5 6.5L17.5 17.5M17.5 6.5L6.5 17.5</Geometry>
        <Geometry x:Key="Icon.Play">M8 5.5V18.5L18.5 12Z</Geometry>
        <Geometry x:Key="Icon.Copy">M10 8.5H18A1.5 1.5 0 0 1 19.5 10V18A1.5 1.5 0 0 1 18 19.5H10A1.5 1.5 0 0 1 8.5 18V10A1.5 1.5 0 0 1 10 8.5ZM15.5 8.5V6A1.5 1.5 0 0 0 14 4.5H6A1.5 1.5 0 0 0 4.5 6V14A1.5 1.5 0 0 0 6 15.5H8.5</Geometry>
        <Geometry x:Key="Icon.Folder">M3.5 7A1.5 1.5 0 0 1 5 5.5H9L11 7.5H19A1.5 1.5 0 0 1 20.5 9V17.5A1.5 1.5 0 0 1 19 19H5A1.5 1.5 0 0 1 3.5 17.5Z</Geometry>
        <Geometry x:Key="Icon.Trash">M4.5 7H19.5M9.5 7V4.5H14.5V7M6.5 7L7.5 19.5H16.5L17.5 7M10 11V16M14 11V16</Geometry>
        <Geometry x:Key="Icon.Search">M11 4.5A6.5 6.5 0 1 1 10.99 4.5ZM16 16L20 20</Geometry>
        <Geometry x:Key="Icon.Camera">M5 7.5H7.5L9 5H15L16.5 7.5H19A1.5 1.5 0 0 1 20.5 9V17.5A1.5 1.5 0 0 1 19 19H5A1.5 1.5 0 0 1 3.5 17.5V9A1.5 1.5 0 0 1 5 7.5ZM12 9.5A3.5 3.5 0 1 1 11.99 9.5Z</Geometry>
        <Geometry x:Key="Icon.Open">M14 4.5H19.5V10M19.5 4.5L11 13M18 14V18A1.5 1.5 0 0 1 16.5 19.5H6.5A1.5 1.5 0 0 1 5 18V8A1.5 1.5 0 0 1 6.5 6.5H10.5</Geometry>
        <Geometry x:Key="Icon.Alert">M12 4L21 19.5H3ZM12 10V14M12 17V17.01</Geometry>
        <Geometry x:Key="Icon.Spark">M12 4V7M12 17V20M4 12H7M17 12H20M6.3 6.3L8.4 8.4M15.6 15.6L17.7 17.7M6.3 17.7L8.4 15.6M15.6 8.4L17.7 6.3</Geometry>
        <Geometry x:Key="Icon.Keyboard">M4.5 6.5H19.5A1.5 1.5 0 0 1 21 8V16A1.5 1.5 0 0 1 19.5 17.5H4.5A1.5 1.5 0 0 1 3 16V8A1.5 1.5 0 0 1 4.5 6.5ZM7 10H7.01M10.5 10H10.51M14 10H14.01M17 10H17.01M8 14H16</Geometry>
        <Geometry x:Key="Icon.Timer">M12 21A7.5 7.5 0 1 0 11.99 21ZM12 10V13.5L14.5 15M9.5 2.5H14.5M19 6.5L20.5 5</Geometry>
        <Geometry x:Key="Icon.Gallery">M5 4.5H10.5V10H5ZM13.5 4.5H19V10H13.5ZM5 13.5H10.5V19H5ZM13.5 13.5H19V19H13.5Z</Geometry>
        <Geometry x:Key="Icon.Globe">M12 3.5A8.5 8.5 0 1 1 11.99 3.5ZM3.5 12H20.5M12 3.5C14.5 6 15.5 9 15.5 12S14.5 18 12 20.5C9.5 18 8.5 15 8.5 12S9.5 6 12 3.5Z</Geometry>
        <Geometry x:Key="Icon.Chip">M8 6.5H16A1.5 1.5 0 0 1 17.5 8V16A1.5 1.5 0 0 1 16 17.5H8A1.5 1.5 0 0 1 6.5 16V8A1.5 1.5 0 0 1 8 6.5ZM10 3.5V6.5M14 3.5V6.5M10 17.5V20.5M14 17.5V20.5M3.5 10H6.5M3.5 14H6.5M17.5 10H20.5M17.5 14H20.5</Geometry>
        <Geometry x:Key="Icon.Power">M12 3.5V11.5M7 6.5A7 7 0 1 0 17 6.5</Geometry>
        <Geometry x:Key="Icon.Info">M12 3.5A8.5 8.5 0 1 1 11.99 3.5ZM12 11V16M12 8V8.01</Geometry>
        <Geometry x:Key="Icon.Exit">M14.5 4.5H18A1.5 1.5 0 0 1 19.5 6V18A1.5 1.5 0 0 1 18 19.5H14.5M10 8L6 12L10 16M6 12H15</Geometry>
        <Geometry x:Key="Icon.ChevronRight">M9.5 6.5L15 12L9.5 17.5</Geometry>
        <Geometry x:Key="Icon.Gpu">M3.5 7.5H20.5V16.5H3.5ZM7 16.5V19M17 16.5V19M8 12A2 2 0 1 0 7.99 12ZM13.5 10.5H17.5M13.5 13.5H17.5</Geometry>
        <Geometry x:Key="Icon.Link">M10 14A4 4 0 0 0 15.66 14L18.66 11A4 4 0 0 0 13 5.34L11.5 6.84M14 10A4 4 0 0 0 8.34 10L5.34 13A4 4 0 0 0 11 18.66L12.5 17.16</Geometry>

        <!-- ═══ Logo «F»: orange viewfinder corners around a three-bar voice wave, no tile, one solid colour.
             One drawing for every size — it is also the tray icon and the .ico (regenerated from this). ═══ -->
        <DrawingImage x:Key="BrandMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0H64V64H0Z"/>
                    <GeometryDrawing Geometry="M6,22V14A8,8 0 0 1 14,6H22M42,6H50A8,8 0 0 1 58,14V22M58,42V50A8,8 0 0 1 50,58H42M22,58H14A8,8 0 0 1 6,50V42">
                        <GeometryDrawing.Pen><Pen Brush="#FF8A4C" Thickness="7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M22,28V36M32,20V44M42,28V36">
                        <GeometryDrawing.Pen><Pen Brush="#FF8A4C" Thickness="7" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <!-- The same mark hinted for the 16–24 px icon frames (tray): 2 px strokes on the 16 px pixel grid, 1 px gaps -->
        <DrawingImage x:Key="BrandMarkSmall">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0H64V64H0Z"/>
                    <GeometryDrawing Geometry="M8,22V16A8,8 0 0 1 16,8H22M42,8H48A8,8 0 0 1 56,16V22M56,42V48A8,8 0 0 1 48,56H42M22,56H16A8,8 0 0 1 8,48V42">
                        <GeometryDrawing.Pen><Pen Brush="#FF8A4C" Thickness="8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M20,28V36M32,18V46M44,28V36">
                        <GeometryDrawing.Pen><Pen Brush="#FF8A4C" Thickness="8" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ═══ Buttons (dark glass). Same keys as before, so every window picks up the new look. ═══ -->

        <!-- Text button without a frame; a frosted fill appears on hover -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E2E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="11"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#2BFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: a white matte button with dark text -->
        <Style x:Key="ActiveButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryInk}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="11" Background="{StaticResource PrimaryFill}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#D9FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action: frosted glass with a thin edge -->
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="11" Background="#14FFFFFF" BorderBrush="{StaticResource PanelRim}" BorderThickness="1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small frosted chip (gallery cards, toasts) -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#E8E8ED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#1AFFFFFF" BorderThickness="1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerChipButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#1AFFFFFF" BorderThickness="1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#59EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips: small dark glass -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F21C1C22"/>
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource PanelRim}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menus (microphone picker in the overlay) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F51A1A20" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" CornerRadius="12" Padding="5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bdr" Background="Transparent" CornerRadius="8" Padding="8,7,14,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="check" Grid.Column="0" Data="M5 12.5L9.5 17L19 7.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B6B78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#1FFFFFFF" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scrollbars -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bdr" CornerRadius="4" Background="#33FFFFFF"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,4">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,3">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
