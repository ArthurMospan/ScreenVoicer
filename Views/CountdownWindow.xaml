<Window x:Class="ScreenVoicer.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenVoicer"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Opacity="0"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Cursor="Hand"
        MouseLeftButtonUp="OnClick"
        ToolTip="Клацніть, щоб скасувати">

    <Border Margin="16" CornerRadius="20" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" Padding="16,10,22,10"
            Effect="{StaticResource CardShadow}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F5202027" Offset="0"/>
                <GradientStop Color="#F5141419" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel Orientation="Horizontal">
            <!-- The brand lamp counts down -->
            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse Stroke="#26FFFFFF" StrokeThickness="2.5"/>
                <Ellipse x:Name="Pulse" Width="14" Height="14" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource AccentGlow}">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFD09A" Offset="0"/>
                            <GradientStop Color="#FF7A3D" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource InkBrush}" FontSize="15" FontWeight="SemiBold">
                    <Run Text="Знімок через "/><Run x:Name="TxtSeconds" Text="3" Foreground="{StaticResource AccentBrush}"/><Run Text=" с"/>
                </TextBlock>
                <TextBlock Text="клацніть, щоб скасувати" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
