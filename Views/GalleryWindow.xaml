<Window x:Class="ScreenVoicer.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenVoicer.Views"
        Title="ScreenVoicer — Галерея"
        Icon="/ScreenVoicer;component/Resources/AppIcon.ico"
        Width="1080" Height="760"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="SmallIcon" TargetType="v:GlyphIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Glass checkbox on a thumbnail: pick several screenshots for one link -->
        <Style x:Key="SelectBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Вибрати — кілька знімків можна віддати одним посиланням"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Border x:Name="box" CornerRadius="8" Background="#A6101014" BorderBrush="#99FFFFFF" BorderThickness="1.5"/>
                            <Border x:Name="fill" CornerRadius="8" Background="{StaticResource AccentFill}" BorderBrush="{StaticResource AccentRim}"
                                    BorderThickness="1" Opacity="0"/>
                            <v:GlyphIcon x:Name="check" Data="{StaticResource Icon.Check}" Width="16" Height="16" StrokeThickness="3.2"
                                         Foreground="#FFFFFF" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="check" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matte card: a flat surface whose edge brightens under the mouse -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#19191F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
                    <Setter Property="Background" Value="#1E1E25"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}" TextElement.Foreground="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource BrandMark}" Width="40" Height="40" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold">
                            <Run Text="Screen"/><Run Text="Voicer" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock x:Name="TxtTotalCount" Text="…" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="360" Height="38" Margin="20,0"
                        Background="#0DFFFFFF" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" CornerRadius="12" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <v:GlyphIcon Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource SmallIcon}"
                                     Foreground="{StaticResource MutedBrush}" Margin="0,0,9,0"/>
                        <TextBox x:Name="TbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="13"
                                 Foreground="{StaticResource InkBrush}" CaretBrush="#FFC68A" SelectionBrush="#FF8A4C" SelectionOpacity="0.45"
                                 VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Пошук за коментарем або датою (Ctrl+F)"
                                   Foreground="{StaticResource FaintBrush}" FontSize="13" VerticalAlignment="Center" Margin="3,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Click="OnOpenFolderClick" Margin="0,0,10,0" ToolTip="Відкрити папку зі скриншотами">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource Icon.Folder}" Style="{StaticResource SmallIcon}"/>
                            <TextBlock Text="Папка" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActiveButton}" Click="OnNewCaptureClick" Padding="14,0" ToolTip="Сховати галерею і зробити знімок">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource Icon.Camera}" Style="{StaticResource SmallIcon}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Новий знімок" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cards -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,12,14,20">
            <ItemsControl x:Name="ItemsGallery">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="326" Margin="8" Padding="10" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="184"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Thumbnail: click to open, drag into any chat/app to attach the PNG -->
                                <Border Grid.Row="0" CornerRadius="10" Background="#0DFFFFFF" Cursor="Hand"
                                        ToolTip="Клацніть — відкрити, перетягніть — вкласти у чат"
                                        MouseLeftButtonDown="OnThumbMouseDown" MouseMove="OnThumbMouseMove" MouseLeftButtonUp="OnThumbMouseUp">
                                    <Grid>
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top"/>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Background="#C70F0F13"
                                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,2">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#E6E6EC"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#C70F0F13"
                                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,2">
                                            <TextBlock Text="{Binding DateText}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        </Border>
                                        <CheckBox Style="{StaticResource SelectBox}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnSelectClick"/>
                                        <!-- the public link of this screenshot: click copies it, × deletes it -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#D90F0F13"
                                                BorderBrush="#80FFC68A" BorderThickness="1" CornerRadius="8" Visibility="{Binding ShareVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PillButton}" Height="26" MinWidth="0" Padding="8,0,6,0" Margin="0"
                                                        Click="OnCopyShareClick" ToolTip="{Binding ShareUrlTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <v:GlyphIcon Data="{StaticResource Icon.Link}" Width="13" Height="13" StrokeThickness="2.2"
                                                                     Foreground="{StaticResource AccentLightBrush}"/>
                                                        <TextBlock Text="{Binding ShareText}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PillButton}" Width="24" Height="26" MinWidth="0" Padding="0" Margin="0"
                                                        Click="OnDeleteShareClick" ToolTip="Видалити посилання: за ним більше нічого не відкриється">
                                                    <v:GlyphIcon Data="{StaticResource Icon.Close}" Width="11" Height="11" StrokeThickness="2.6"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- the comment is a caption under the picture: plain text, no icon -->
                                <TextBlock Grid.Row="1" Margin="2,11,2,9" MinHeight="38" Text="{Binding CommentText}" Foreground="{Binding CommentBrush}"
                                           FontSize="13" TextWrapping="Wrap" MaxHeight="57" TextTrimming="CharacterEllipsis"
                                           LineHeight="19" ToolTip="{Binding CommentText}"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource ChipButton}" Click="OnCopyMarkdownClick" ToolTip="Скопіювати Markdown і картинку">
                                        <StackPanel Orientation="Horizontal">
                                            <v:GlyphIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" StrokeThickness="2"/>
                                            <TextBlock Text="Копіювати" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnCopyTextClick" ToolTip="Скопіювати лише текст коментаря"
                                            Visibility="{Binding TextButtonVisibility}">
                                        <TextBlock Text="Текст"/>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnShareItemClick" ToolTip="{Binding ShareButtonTip}">
                                        <v:GlyphIcon Data="{StaticResource Icon.Link}" Width="14" Height="14" StrokeThickness="2"/>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnShowInFolderClick" ToolTip="Показати в провіднику">
                                        <v:GlyphIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" StrokeThickness="2"/>
                                    </Button>
                                    <Button Style="{StaticResource DangerChipButton}" Click="OnDeleteClick" ToolTip="Видалити">
                                        <v:GlyphIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" StrokeThickness="2"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty / no results -->
        <StackPanel x:Name="PanelEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Image Source="{StaticResource BrandMark}" Width="88" Height="88" Margin="0,0,0,18"/>
            <TextBlock x:Name="TxtEmptyTitle" Text="Ще немає скриншотів" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtEmptyHint" FontSize="13.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,7,0,20" TextWrapping="Wrap" MaxWidth="460"
                       Text="Натисніть Alt+Shift+S у будь-якій програмі, виділіть область, затисніть Пробіл і розкажіть, що не так."/>
            <Button x:Name="BtnEmptyCapture" Style="{StaticResource ActiveButton}" HorizontalAlignment="Center" Padding="16,0" Height="38" Click="OnNewCaptureClick">
                <StackPanel Orientation="Horizontal">
                    <v:GlyphIcon Data="{StaticResource Icon.Camera}" Style="{StaticResource SmallIcon}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Зробити перший знімок" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Shown while screenshots are selected: one link for all of them -->
        <Border x:Name="SelectionBar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Visibility="Collapsed" CornerRadius="16" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" Padding="8"
                Effect="{StaticResource CardShadow}">
            <Border.Background>
                <SolidColorBrush Color="#F51C1C22"/>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtSelection" VerticalAlignment="Center" Margin="10,0,16,0" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"/>
                <Button x:Name="BtnShareSelected" Style="{StaticResource ActiveButton}" Padding="14,0" Click="OnShareSelectedClick">
                    <StackPanel Orientation="Horizontal">
                        <v:GlyphIcon Data="{StaticResource Icon.Link}" Style="{StaticResource SmallIcon}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Створити посилання" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Content="Зняти вибір" Margin="6,0,0,0" Click="OnClearSelectionClick"/>
            </StackPanel>
        </Border>

        <!-- Snackbar -->
        <Border x:Name="Snackbar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="#F21E1E25" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" CornerRadius="12" Padding="16,10"
                Opacity="0" IsHitTestVisible="False" Effect="{StaticResource CardShadow}">
            <TextBlock x:Name="TxtSnackbar" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
