<Window x:Class="ScreenVoicer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenVoicer.Views"
        Title="ScreenVoicer"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FocusVisualStyle="{x:Null}">
    <!-- No AllowsTransparency: the screenshot covers the whole window anyway, and a full-screen layered window
         is software-rendered, which made opening the overlay and drawing on it laggy. -->

    <Window.Resources>
        <!-- Matte glass: the blurred screenshot (set from code) under a neutral frosted tint and one thin even edge -->
        <SolidColorBrush x:Key="GlassTint" Color="#A6202028"/>
        <SolidColorBrush x:Key="GlassEdge" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="GlassText" Color="#F4F4F7"/>
        <SolidColorBrush x:Key="GlassMuted" Color="#CFCFD6"/>

        <DropShadowEffect x:Key="GlassShadow" BlurRadius="28" ShadowDepth="5" Opacity="0.35" Color="#000000"/>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="#29FFFFFF"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Chevron" TargetType="v:GlyphIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Chevron}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="StrokeThickness" Value="2.6"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="2,1,0,0"/>
        </Style>

        <!-- Round icon buttons. Same keys as before: the code switches tools between PillButton and ActiveButton. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="17" Background="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#2BFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selected: just a lighter frosted disc — no tint, no rim -->
        <Style x:Key="ActiveButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="17" Background="{StaticResource ActiveTint}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#47FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save: a square of denser glass with a thin white edge — the square shape sets it apart from the round tools -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="11" Background="#57FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#6BFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelayButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="ring" Property="Stroke" Value="#F3F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="PulseRecording" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecPulsingRing" Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0.08" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="RecPulsingRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="1.4" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="RecPulsingRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="1.4" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}" SizeChanged="OnRootSizeChanged">
        <!-- 0: frozen screenshot, pixel-for-pixel -->
        <Image x:Name="ImgScreenshot" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- 1: dim everything except the selected region -->
        <Path x:Name="DimPath" Fill="#8C000000" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="DimOuter" Rect="0,0,100000,100000"/>
                    <RectangleGeometry x:Name="DimHole"/>
                </GeometryGroup>
            </Path.Data>
        </Path>

        <!-- 2: region selection input (also catches drags outside the current selection = new selection) -->
        <Canvas x:Name="SelectionCanvas" Background="Transparent" Cursor="Cross"
                MouseLeftButtonDown="OnSelectionMouseDown"
                MouseMove="OnSelectionMouseMove"
                MouseLeftButtonUp="OnSelectionMouseUp"
                LostMouseCapture="OnSelectionLostCapture"/>

        <!-- 3: annotations; clipped to the selection in region mode -->
        <InkCanvas x:Name="InkDrawCanvas" Background="Transparent" Visibility="Collapsed"
                   PreviewMouseLeftButtonDown="OnInkMouseDown"
                   PreviewMouseMove="OnInkMouseMove"
                   PreviewMouseLeftButtonUp="OnInkMouseUp"/>

        <!-- 4: selection frame and size badge -->
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="FrameShadow" Stroke="#66000000" StrokeThickness="3" Visibility="Collapsed"/>
            <Rectangle x:Name="FrameLine" Stroke="#FFFFFF" StrokeThickness="1.25" Visibility="Collapsed"/>
            <Border x:Name="SizeBadge" Background="#D914141A" BorderBrush="{StaticResource PanelRim}" BorderThickness="1"
                    CornerRadius="7" Padding="7,3" Visibility="Collapsed">
                <TextBlock x:Name="TxtSize" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
        </Canvas>

        <!-- 5: first-use hint -->
        <Border x:Name="HintBadge" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                CornerRadius="18" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" Effect="{StaticResource GlassShadow}">
            <Border CornerRadius="17" Background="{StaticResource GlassTint}" Padding="16,12,20,12">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource BrandMark}" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Виділіть область мишкою" Foreground="{StaticResource GlassText}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Enter — весь екран  ·  Пробіл або мікрофон — голос  ·  Esc — скасувати" Foreground="{StaticResource GlassMuted}"
                                   FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 6: the one bar: capture mode, tools (open on hover), voice + comment, save -->
        <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                CornerRadius="23" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" Effect="{StaticResource GlassShadow}"
                SizeChanged="OnToolbarSizeChanged">
            <Border CornerRadius="22" Background="{StaticResource GlassTint}" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnModeRegion" Style="{StaticResource ActiveButton}" Click="OnModeRegionClick" ToolTip="Виділити область">
                        <v:GlyphIcon Data="{StaticResource Icon.Region}"/>
                    </Button>
                    <Button x:Name="BtnModeFull" Style="{StaticResource PillButton}" Click="OnModeFullClick" ToolTip="Весь екран">
                        <v:GlyphIcon Data="{StaticResource Icon.Screen}"/>
                    </Button>
                    <Button x:Name="BtnTimer" Style="{StaticResource PillButton}" Click="OnTimerAnchorClick"
                            ToolTip="Знімок із затримкою: наведіть і оберіть секунди — встигнете відкрити меню чи підказку">
                        <v:GlyphIcon Data="{StaticResource Icon.Timer}"/>
                    </Button>

                    <Rectangle Style="{StaticResource Divider}"/>

                    <Button x:Name="BtnTool" Style="{StaticResource PillButton}" Width="46" Click="OnToolAnchorClick"
                            ToolTip="Інструменти (наведіть, щоб обрати)">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="ToolIconHost"/>
                            <v:GlyphIcon Style="{StaticResource Chevron}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnColor" Style="{StaticResource PillButton}" Width="46" Click="OnColorAnchorClick"
                            ToolTip="Колір і товщина (наведіть, щоб обрати)">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="ColorDot" Stroke="#59FFFFFF" StrokeThickness="1"/>
                            </Grid>
                            <v:GlyphIcon Style="{StaticResource Chevron}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUndo" Style="{StaticResource PillButton}" Click="OnUndoClick" ToolTip="Скасувати (Ctrl+Z)">
                        <v:GlyphIcon Data="{StaticResource Icon.Undo}"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource PillButton}" Click="OnRedoClick" ToolTip="Повторити (Ctrl+Y)">
                        <v:GlyphIcon Data="{StaticResource Icon.Redo}"/>
                    </Button>

                    <Rectangle Style="{StaticResource Divider}"/>

                    <!-- voice: click = start/stop, Space = hold to talk (a short tap keeps recording) -->
                    <Button x:Name="BtnRecord" Style="{StaticResource PillButton}" Click="OnRecordClick"
                            ToolTip="Голос: клацніть, щоб почати й зупинити запис, або утримуйте Пробіл">
                        <Grid Width="34" Height="34">
                            <Ellipse x:Name="RecPulsingRing" Fill="#FF4D5E" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="LevelRing" Stroke="#FF8E99" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="LevelScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MicCircle" Fill="Transparent"/>
                            <v:GlyphIcon x:Name="MicGlyph" Data="{StaticResource Icon.Mic}" Foreground="#F4F4F5"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnMicrophone" Style="{StaticResource PillButton}" Width="16" Margin="-3,0,2,0"
                            Click="OnMicrophoneClick" ToolTip="Обрати мікрофон">
                        <v:GlyphIcon Style="{StaticResource Chevron}" Margin="0,1,0,0"/>
                    </Button>

                    <Grid Width="300" VerticalAlignment="Center" Margin="4,0,6,0">
                        <TextBox x:Name="TbComment" Background="Transparent" BorderThickness="0" Padding="0,7"
                                 FontSize="14" Foreground="{StaticResource GlassText}" CaretBrush="#FFC68A" SelectionBrush="#FF8A4C" SelectionOpacity="0.45"
                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="88" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Center" TextChanged="OnCommentTextChanged"/>
                        <TextBlock x:Name="TxtPlaceholder" IsHitTestVisible="False" Margin="2,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource GlassMuted}" TextTrimming="CharacterEllipsis"
                                   Text="Говоріть або напишіть коментар"/>
                    </Grid>

                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"
                            ToolTip="Зберегти PNG і скопіювати Markdown (Enter)">
                        <v:GlyphIcon Data="{StaticResource Icon.Check}" StrokeThickness="2.3"/>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Click="OnCancelClick" ToolTip="Скасувати (Esc)">
                        <v:GlyphIcon Data="{StaticResource Icon.Close}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- 7: status pill under (or above) the bar: only while recording / recognizing / after a result or a problem -->
        <Border x:Name="StatusPill" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"
                IsHitTestVisible="False" CornerRadius="15" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                Effect="{StaticResource GlassShadow}">
            <Border CornerRadius="14" Background="{StaticResource GlassTint}" Padding="12,5,14,6">
                <StackPanel Orientation="Horizontal">
                    <v:GlyphIcon x:Name="BusyGlyph" Data="{StaticResource Icon.Spark}" Width="13" Height="13" Margin="0,0,7,0"
                                 Foreground="{StaticResource AccentLightBrush}" StrokeThickness="2.4" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <v:GlyphIcon.RenderTransform>
                            <RotateTransform x:Name="BusyRotation"/>
                        </v:GlyphIcon.RenderTransform>
                    </v:GlyphIcon>
                    <TextBlock x:Name="TxtStatus" Foreground="{StaticResource GlassText}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 8: flyouts of the toolbar (positioned from code next to their buttons) -->
        <Canvas x:Name="FlyoutLayer">
            <Border x:Name="ToolFlyout" Visibility="Collapsed" CornerRadius="21" BorderBrush="{StaticResource GlassEdge}"
                    BorderThickness="1" Effect="{StaticResource GlassShadow}">
                <Border CornerRadius="20" Background="{StaticResource GlassTint}" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPen" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Pen" ToolTip="Олівець (P)">
                            <v:GlyphIcon Data="{StaticResource Icon.Pen}"/>
                        </Button>
                        <Button x:Name="BtnHighlighter" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Highlighter" ToolTip="Маркер (H)">
                            <v:GlyphIcon Data="{StaticResource Icon.Highlighter}"/>
                        </Button>
                        <Button x:Name="BtnArrow" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Arrow" ToolTip="Стрілка (A), Shift — під кутом 45°">
                            <v:GlyphIcon Data="{StaticResource Icon.Arrow}"/>
                        </Button>
                        <Button x:Name="BtnRectangle" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Rectangle" ToolTip="Рамка (R), Shift — квадрат">
                            <v:GlyphIcon Data="{StaticResource Icon.Rectangle}"/>
                        </Button>
                        <Button x:Name="BtnText" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Text"
                                ToolTip="Текст (T): клацніть, напишіть, Enter. Подвійний клік — редагувати, перетягування — перемістити">
                            <v:GlyphIcon Data="{StaticResource Icon.Text}"/>
                        </Button>
                        <Button x:Name="BtnMarker" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Marker"
                                ToolTip="Нумерована мітка (N): 1, 2, 3…">
                            <v:GlyphIcon Data="{StaticResource Icon.Number}"/>
                        </Button>
                        <Button x:Name="BtnEraser" Style="{StaticResource PillButton}" Click="OnToolClick" Tag="Eraser" ToolTip="Гумка (E)">
                            <v:GlyphIcon Data="{StaticResource Icon.Eraser}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="TimerFlyout" Visibility="Collapsed" CornerRadius="21" BorderBrush="{StaticResource GlassEdge}"
                    BorderThickness="1" Effect="{StaticResource GlassShadow}">
                <Border CornerRadius="20" Background="{StaticResource GlassTint}" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource DelayButton}" Content="3 с" Tag="3" Click="OnDelayClick"
                                ToolTip="Сховати вікно й зняти екран заново через 3 секунди"/>
                        <Button Style="{StaticResource DelayButton}" Content="5 с" Tag="5" Click="OnDelayClick"
                                ToolTip="Сховати вікно й зняти екран заново через 5 секунд"/>
                        <Button Style="{StaticResource DelayButton}" Content="10 с" Tag="10" Click="OnDelayClick"
                                ToolTip="Сховати вікно й зняти екран заново через 10 секунд"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="ColorFlyout" Visibility="Collapsed" CornerRadius="21" BorderBrush="{StaticResource GlassEdge}"
                    BorderThickness="1" Effect="{StaticResource GlassShadow}">
                <Border CornerRadius="20" Background="{StaticResource GlassTint}" Padding="6,5">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Swatch}" Background="#EF4444" Click="OnSwatchClick" ToolTip="Червоний (1)"/>
                            <Button Style="{StaticResource Swatch}" Background="#FACC15" Click="OnSwatchClick" ToolTip="Жовтий (2)"/>
                            <Button Style="{StaticResource Swatch}" Background="#22C55E" Click="OnSwatchClick" ToolTip="Зелений (3)"/>
                            <Button Style="{StaticResource Swatch}" Background="#3B82F6" Click="OnSwatchClick" ToolTip="Синій (4)"/>
                            <Button Style="{StaticResource Swatch}" Background="#18181B" Click="OnSwatchClick" ToolTip="Чорний (5)"/>
                            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Click="OnSwatchClick" ToolTip="Білий (6)"/>
                        </StackPanel>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <Button x:Name="BtnThickness" Style="{StaticResource PillButton}" Click="OnThicknessClick">
                            <Ellipse x:Name="ThicknessDot" Width="7" Height="7" Fill="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
        </Canvas>
    </Grid>
</Window>
