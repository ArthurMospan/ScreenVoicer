<Window x:Class="ScreenVoicer.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenVoicer.Views"
        Title="ScreenVoicer"
        Width="404" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Opacity="0"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="ToastBtn" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="ToastPrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActiveButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <!-- Room around the card for its shadow -->
    <Border x:Name="Card" Margin="14" CornerRadius="16" BorderBrush="{StaticResource PanelRim}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave">
        <Border.Background>
            <SolidColorBrush Color="#F51B1B21"/>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="16"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,13,10,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status badge, the logo, or a screenshot thumbnail (ImageBrush so the rounded corners really clip it) -->
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Border x:Name="IconBadge" CornerRadius="12" BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
                        <Grid>
                            <Border CornerRadius="12" Background="{StaticResource GlassSheen}" Opacity="0.6"/>
                            <v:GlyphIcon x:Name="BadgeIcon" Width="20" Height="20" StrokeThickness="2.2"/>
                        </Grid>
                    </Border>
                    <Image x:Name="BadgeLogo" Source="{StaticResource BrandMark}" Visibility="Collapsed"/>
                    <Border x:Name="Thumb" CornerRadius="10" Visibility="Collapsed" Cursor="Hand"
                            BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonDown="OnThumbDown" MouseMove="OnThumbMove"
                            MouseLeftButtonUp="OnThumbClick" ToolTip="Клік — відкрити знімок, перетягніть — щоб покласти файл у чат чи задачу">
                        <Border.Background>
                            <ImageBrush x:Name="ThumbBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="ScreenVoicer" Foreground="#F3F3F6" FontSize="13.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtMessage" Foreground="#A9A9B6" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,2,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                </StackPanel>

                <Button Grid.Column="2" Width="24" Height="24" Margin="6,-4,0,0" VerticalAlignment="Top" Padding="0"
                        Style="{StaticResource PillButton}" Foreground="#8C8C99" Click="OnCloseClick" ToolTip="Закрити">
                    <v:GlyphIcon Data="{StaticResource Icon.Close}" Width="13" Height="13" StrokeThickness="2.4"/>
                </Button>
            </Grid>

            <StackPanel x:Name="PanelActions" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,12,12" Visibility="Collapsed">
                <Button x:Name="BtnOpenImage" Style="{StaticResource ToastBtn}" Content="Відкрити" Click="OnOpenImageClick" Visibility="Collapsed"/>
                <Button x:Name="BtnCopy" Style="{StaticResource ToastBtn}" Content="Копіювати" Click="OnCopyClick" Visibility="Collapsed"/>
                <Button x:Name="BtnAction" Style="{StaticResource ToastBtn}" Click="OnActionClick" Visibility="Collapsed"/>
                <Button x:Name="BtnOpenGallery" Style="{StaticResource ToastPrimaryBtn}" Content="Галерея" Click="OnOpenGalleryClick" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Time-left indicator; pauses while the mouse is over the toast -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" ClipToBounds="True" Margin="12,0,12,0">
                <Rectangle x:Name="TimeBar" Height="2" VerticalAlignment="Top" Fill="{StaticResource AccentBrush}" Opacity="0.55" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="TimeScale" ScaleX="1"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
