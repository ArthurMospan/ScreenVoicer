<Window x:Class="ScreenVoicer.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenVoicer.Views"
        Title="ScreenVoicer"
        Width="376" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Opacity="0">

    <Window.Resources>
        <!-- One line of the menu: icon, label, value on the right; glass highlight on hover -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="10" Background="Transparent"/>
                            <Border x:Name="rim" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource GlassRim}" Opacity="0"/>
                            <ContentPresenter Margin="9,8,10,8" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="rim" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIcon" TargetType="v:GlyphIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="#C9C6CF"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="160"/>
        </Style>

        <Style x:Key="SmallChevron" TargetType="v:GlyphIcon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="StrokeThickness" Value="2.6"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="5,1,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- Glass chip: delay buttons, the language switch -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6EC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="9" Background="#0FFFFFFF"/>
                            <Border x:Name="sheen" CornerRadius="9" Background="{StaticResource GlassSheen}" Opacity="0"/>
                            <Border x:Name="rim" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource GlassRim}" Opacity="0.3"/>
                            <ContentPresenter Margin="11,6,11,7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="rim" Property="Opacity" Value="0.7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="fill" Property="Background" Value="{StaticResource ActiveTint}"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1"/>
                                <Setter TargetName="rim" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Separator" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="#17FFFFFF"/>
            <Setter Property="Margin" Value="8,5"/>
        </Style>

        <!-- Expanded lists (microphones, models) sit in a recessed well -->
        <Style x:Key="Well" TargetType="Border">
            <Setter Property="Margin" Value="38,0,4,4"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#24000000"/>
            <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Room around the card for its shadow -->
    <Border x:Name="Card" Margin="16" CornerRadius="18" Effect="{StaticResource CardShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="10"/>
        </Border.RenderTransform>
        <Grid>
            <!-- glass: the blurred desktop behind the card (set from code), a dark tint, a rim catching light -->
            <Border x:Name="Backdrop" CornerRadius="18" Background="#141418"/>
            <Border CornerRadius="18" Background="#B8141418"/>
            <Border CornerRadius="18" Background="{StaticResource GlassSheen}" Opacity="0.35"/>
            <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource PanelRim}"/>

            <StackPanel Margin="10">
                <!-- header: logo, voice status, version -->
                <Grid Margin="6,4,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource BrandMark}" Width="38" Height="38" Margin="0,0,11,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="#F3F3F6">
                            <Run Text="Screen"/><Run Text="Voicer" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#4ADE80" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtVersion" Grid.Column="2" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,3,2,0"/>
                </Grid>

                <!-- update available: an orange-tinted glass strip above everything else -->
                <Border x:Name="UpdateBanner" CornerRadius="11" Background="#24FF8A4C" BorderBrush="#66FFC68A" BorderThickness="1"
                        Margin="0,0,0,8" Visibility="Collapsed">
                    <Button x:Name="BtnUpdate" Style="{StaticResource Row}" Click="OnUpdateClick">
                        <DockPanel>
                            <v:GlyphIcon Data="{StaticResource Icon.Spark}" Style="{StaticResource RowIcon}" Foreground="{StaticResource AccentLightBrush}"/>
                            <TextBlock x:Name="TxtUpdateAction" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center" Text="Оновити"/>
                            <TextBlock x:Name="TxtUpdate" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Button>
                </Border>

                <!-- capture -->
                <Button x:Name="BtnCapture" Style="{StaticResource ActiveButton}" Height="46" HorizontalContentAlignment="Stretch" Padding="14,0" Click="OnCaptureClick">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <v:GlyphIcon Data="{StaticResource Icon.Camera}" Width="19" Height="19" StrokeThickness="2"/>
                            <TextBlock Text="Зробити знімок" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#33000000" CornerRadius="7" Padding="7,3">
                            <TextBlock x:Name="TxtCaptureHotkey" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal" Margin="6,9,0,2">
                    <v:GlyphIcon Data="{StaticResource Icon.Timer}" Width="15" Height="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="Із затримкою" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Chip}" Content="3 с" Tag="3" Click="OnDelayClick"/>
                    <Button Style="{StaticResource Chip}" Content="5 с" Tag="5" Click="OnDelayClick"/>
                    <Button Style="{StaticResource Chip}" Content="10 с" Tag="10" Click="OnDelayClick"/>
                </StackPanel>

                <Rectangle Style="{StaticResource Separator}"/>

                <Button Style="{StaticResource Row}" Click="OnGalleryClick">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Gallery}" Style="{StaticResource RowIcon}"/>
                        <TextBlock x:Name="TxtGalleryCount" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                        <TextBlock Text="Галерея" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource Row}" Click="OnFolderClick">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Folder}" Style="{StaticResource RowIcon}"/>
                        <TextBlock Text="Папка зі скриншотами" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <Rectangle Style="{StaticResource Separator}"/>

                <!-- microphone -->
                <Button Style="{StaticResource Row}" Click="OnMicrophoneToggle">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Mic}" Style="{StaticResource RowIcon}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TxtMicrophone" Style="{StaticResource RowValue}"/>
                            <v:GlyphIcon x:Name="MicChevron" Data="{StaticResource Icon.Chevron}" Style="{StaticResource SmallChevron}"/>
                        </StackPanel>
                        <TextBlock Text="Мікрофон" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Border x:Name="MicWell" Style="{StaticResource Well}" Visibility="Collapsed">
                    <StackPanel x:Name="MicList"/>
                </Border>

                <!-- language -->
                <Grid Margin="9,6,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <v:GlyphIcon Data="{StaticResource Icon.Globe}" Style="{StaticResource RowIcon}"/>
                    <TextBlock Grid.Column="1" Text="Мова голосу" FontSize="13.5" Foreground="#F3F3F6" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#0FFFFFFF" CornerRadius="10" Padding="2" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel x:Name="LanguagePanel" Orientation="Horizontal">
                            <Button Style="{StaticResource Chip}" Content="УКР" Tag="uk" Margin="0" Click="OnLanguageClick" ToolTip="Українська"/>
                            <Button Style="{StaticResource Chip}" Content="ENG" Tag="en" Margin="0" Click="OnLanguageClick" ToolTip="English"/>
                            <Button Style="{StaticResource Chip}" Content="Авто" Tag="auto" Margin="0" Click="OnLanguageClick" ToolTip="Автовизначення (повільніше)"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- recognition model -->
                <Button Style="{StaticResource Row}" Click="OnModelToggle">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Chip}" Style="{StaticResource RowIcon}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TxtModel" Style="{StaticResource RowValue}"/>
                            <v:GlyphIcon x:Name="ModelChevron" Data="{StaticResource Icon.Chevron}" Style="{StaticResource SmallChevron}"/>
                        </StackPanel>
                        <TextBlock Text="Розпізнавання" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Border x:Name="ModelWell" Style="{StaticResource Well}" Visibility="Collapsed">
                    <StackPanel x:Name="ModelList"/>
                </Border>

                <Button Style="{StaticResource Row}" Click="OnHotkeyClick">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Keyboard}" Style="{StaticResource RowIcon}"/>
                        <TextBlock x:Name="TxtHotkey" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                        <TextBlock Text="Гаряча клавіша" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource Row}" Click="OnAutostartClick">
                    <DockPanel>
                        <v:GlyphIcon Data="{StaticResource Icon.Power}" Style="{StaticResource RowIcon}"/>
                        <Grid x:Name="AutostartToggle" DockPanel.Dock="Right" Width="36" Height="21">
                            <Border x:Name="ToggleTrack" CornerRadius="10.5"/>
                            <Ellipse x:Name="ToggleKnob" Width="15" Height="15" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0"/>
                        </Grid>
                        <TextBlock Text="Запуск з Windows" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <Rectangle Style="{StaticResource Separator}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Row}" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" Click="OnAboutClick">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource Icon.Info}" Style="{StaticResource RowIcon}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Про програму" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource Row}" Foreground="{StaticResource MutedBrush}" Click="OnExitClick">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource Icon.Exit}" Style="{StaticResource RowIcon}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Вийти" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="AboutWell" Style="{StaticResource Well}" Margin="4,2,4,4" Padding="12,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtAbout" FontSize="12" Foreground="#C9C6CF" TextWrapping="Wrap" LineHeight="18"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Chip}" Content="Перевірити оновлення" Click="OnCheckUpdatesClick"/>
                            <Button Style="{StaticResource Chip}" Content="Журнал" Click="OnOpenLogClick"/>
                            <Button Style="{StaticResource Chip}" Content="Моделі" Click="OnOpenModelsClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
